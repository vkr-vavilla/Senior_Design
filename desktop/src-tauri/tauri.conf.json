{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrepAI",
  "version": "0.1.0",
  "identifier": "com.prepai.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PrepAI",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "AI mock-interview practice, running locally.",
    "longDescription": "PrepAI runs a full AI interview stack on your machine — auto-detecting the best local inference engine (vLLM on NVIDIA, Ollama on Mac/AMD/CPU) or falling back to the Gemini API."
  }
}
