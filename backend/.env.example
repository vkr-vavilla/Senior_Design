MONGODB_URI=mongodb://localhost:27017
DB_NAME=FinalRound
# Collection holding the LeetCode problem bank
PROBLEMS_COLLECTION=leetcode
# Code execution backend: "piston" (sandboxed) or "local" (subprocess, no isolation)
CODE_EXECUTOR=piston
# Piston sandbox URL (compose network); only used when CODE_EXECUTOR=piston
PISTON_URL=http://piston:2000
JWT_SECRET=your-secret-key-here
JWT_ALGORITHM=HS256
# Access tokens are short-lived; a refresh_token cookie (see COOKIE_SECURE below)
# silently renews them. ACCESS_TOKEN_EXPIRE_MINUTES=10080 (7 days) is a
# reasonable fallback if you don't want to rely on the refresh flow.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Refresh-token cookie: must be "true" (Secure + SameSite=None) for any deployment
# where the frontend and backend are on different domains (e.g. Vercel + Cloud
# Run) — browsers won't send the cookie cross-site otherwise. Set to "false" only
# for local http://localhost development.
COOKIE_SECURE=true
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# AI Backend: "gemini" (default) or "vllm" (local LLM)
AI_BACKEND=gemini
VLLM_BASE_URL=http://localhost:8080/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Safety classifier: two-stage prompt safety gate (heuristic + Llama Guard 3 8B via Groq).
# Set to "false" to disable entirely (dev/testing only).
SAFETY_CLASSIFIER_ENABLED=true
