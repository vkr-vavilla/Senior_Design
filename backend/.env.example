MONGODB_URI=mongodb://localhost:27017
DB_NAME=FinalRound
# Collection holding the LeetCode problem bank
PROBLEMS_COLLECTION=leetcode
# Code execution backend: "judge0" (hosted sandbox), "piston" (self-hosted sandbox),
# or "local" (subprocess, no isolation — dev only)
CODE_EXECUTOR=judge0
# Piston sandbox URL (compose network); only used when CODE_EXECUTOR=piston
PISTON_URL=http://piston:2000
# Judge0: only used when CODE_EXECUTOR=judge0. Defaults target the RapidAPI-hosted
# instance — subscribe at rapidapi.com/judge0-official/api/judge0-ce and put your
# RapidAPI key in JUDGE0_API_KEY. For a self-hosted Judge0 instead, set JUDGE0_URL
# to your own host and leave JUDGE0_API_KEY blank (use JUDGE0_AUTH_TOKEN if that
# instance has X-Auth-Token enabled).
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your-rapidapi-key-here
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
JUDGE0_AUTH_TOKEN=
JWT_SECRET=your-secret-key-here
JWT_ALGORITHM=HS256
# Access tokens are short-lived; a refresh_token cookie (see COOKIE_SECURE below)
# silently renews them. ACCESS_TOKEN_EXPIRE_MINUTES=10080 (7 days) is a
# reasonable fallback if you don't want to rely on the refresh flow.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Refresh-token cookie: must be "true" (Secure + SameSite=None) for any deployment
# where the frontend and backend are on different domains (e.g. Vercel + Cloud
# Run) — browsers won't send the cookie cross-site otherwise. Set to "false" only
# for local http://localhost development.
COOKIE_SECURE=true
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# AI Backend: "gemini" (default) or "vllm" (local LLM)
AI_BACKEND=gemini
VLLM_BASE_URL=http://localhost:8080/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Speech-to-text: the user picks the engine per-interview at setup ("Groq" —
# premium, fast, needs GROQ_API_KEY above — vs "Faster-Whisper" — standard,
# free/unlimited, slower). Groq is the frontend default. No env var selects
# this; WHISPER_MODEL below only configures the "Faster-Whisper" option.
# Whisper size for the local engine: tiny/base/small/medium (bigger = more
# accurate, more RAM, slower). "small" is ~1.5GB RAM with int8 quantization.
WHISPER_MODEL=small

# Text-to-speech: Google Cloud TTS (4M characters/month free, no expiration, for
# Standard/WaveNet voices). Requires the "Cloud Text-to-Speech API" enabled on
# the GCP project and the Cloud Run service account granted the "Cloud
# Text-to-Speech API User" role — no API key needed, auth is automatic via
# Application Default Credentials on Cloud Run. For local dev, run
# `gcloud auth application-default login` once.

# Safety classifier: two-stage prompt safety gate (heuristic + Llama Guard 3 8B via Groq).
# Set to "false" to disable entirely (dev/testing only).
SAFETY_CLASSIFIER_ENABLED=true
